TELEGRAM_BOT_TOKEN=put-your-bot-token-here
TELEGRAM_CHAT_ID=put-your-numeric-telegram-id-here
# One forum supergroup per PC. Omit for DM-only mode.
# Form: the full negative id as shown by getUpdates (e.g. -1001234567890).
TELEGRAM_FORUM_CHAT_ID=
# Optional. Default: ~/.config/herdr/herdr.sock
# HERDR_SOCKET=
# Optional. State dir for jobs/focus/offset/topics files (default: launch
# directory). All runs MUST share one — split dirs replay prompts.
# HERDR_STATE_DIR=
# Optional. Single-instance guard port (default: 47319). Override so prod
# and dev can run side by side on one machine — but side-by-side needs a
# SEPARATE bot token (and state dir), never the same token twice.
# HERDR_TG_PORT=
